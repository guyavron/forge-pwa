# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The anon/publishable key is meant to be public/client-embedded — Supabase's Row Level
# Security policies are the real security boundary, not keeping this secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (no VITE_ prefix, so it never reaches the browser bundle). Used by the
# api/scan-meal.ts serverless function for AI meal scanning. Get one at aistudio.google.com.
# For local dev with the API route, run `npx vercel dev` instead of `npm run dev`.
GEMINI_API_KEY=your-gemini-api-key
